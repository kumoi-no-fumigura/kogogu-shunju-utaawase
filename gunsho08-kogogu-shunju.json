 ],
 "poems": [
  {
   "seq": "1",
   "text": "春たては先もろ人もひきつれて萬代ふへき宿に社くれ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "くもりなき空の鏡とみゆる哉あきの夜なかく照す月影",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "けふ祭る春日の山の神ませはあめの下には君そさかへん",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "萬代に君そ見るへきたなはたの行あひの空を雲の上にて",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春雨にぬれてたつれむ櫻花雲のかへしの嵐もそふく",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ひく駒の數より外に見えつるは關の〓水の影にそありける",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "山里の垣根に春やしるからむかすまぬさきに鶯のなく",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "折やせむおらてや見まし秋萩に露も心をかけぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いつれをかわきてひかまし春日野のなへて千年の松の綠を",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "小夜更て旅の空にて鳴雁はをのか羽風や夜寒成らむ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "岩間もる水にそやとる梅花稍は風のうしろめたさに",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "秋の夜の山田のいほは稻妻の光のみこそもりあかしけれ",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "みな人の心にかけてくる物は岸になみよる靑柳の絲",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "大井河瀧つせもなく秋ふかみ紅葉の淵と成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "花ならておらまほしきはなには江の芦の若葉にふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "紫のまたあかさりし二葉にも菊に心はそめてしものを",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "長濵の眞砂の數もなにならすつきせすみゆる君か御代か",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "住の江に生そふ松の枝ことに君かちとせの數そこもれる",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
